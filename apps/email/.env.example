# Same physical Postgres database as apps/backend/apps/ai, isolated in its
# own "email" schema -- see docs/DATABASE.md "Email schema isolation". Same
# pgbouncer rule: EMAIL_DATABASE_URL = pooled (port 6543), EMAIL_DIRECT_URL =
# direct (port 5432, migrations only). Quote these values in your .env --
# the `&` between query params is otherwise interpreted as a shell
# background-job operator if this file is ever `source`d directly.
EMAIL_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=email"
EMAIL_DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres?schema=email"

# Same Upstash Redis instance as the other services -- rate limiting AND the
# BullMQ send queue (EMAIL_SEND_QUEUE/EMAIL_SEND_DLQ).
REDIS_URL="rediss://default:<password>@<db-name>.upstash.io:6379"

PORT=8005

# Comma-separated, own key set. Generate with e.g. `openssl rand -hex 32`.
EMAIL_API_KEYS=

# apps/email fetches draft content from apps/ai and creator identity from
# apps/backend over HTTP rather than querying their tables directly.
AI_SERVICE_URL="http://localhost:8004"
AI_SERVICE_API_KEY=
BACKEND_URL="http://localhost:3000"
BACKEND_API_KEY=

# CORS: comma-separated allowed browser origins. Empty/unset = deny all
# cross-origin requests (default).
CORS_ALLOWED_ORIGINS=

EMAIL_REQUEST_TIMEOUT_MS=20000
EMAIL_CIRCUIT_BREAKER_THRESHOLD=5

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
API_KEY_RATE_LIMIT_MAX=120

# PROJECT.md's own documented sending-rate env vars.
MAX_EMAILS_PER_DAY=200
MAX_EMAILS_PER_HOUR=30
EMAIL_DELAY_MIN=30
EMAIL_DELAY_MAX=120

# Queue (BullMQ)
EMAIL_QUEUE_CONCURRENCY=1
EMAIL_QUEUE_MAX_ATTEMPTS=3
EMAIL_QUEUE_BACKOFF_MS=5000

# Provider credentials -- only the ones a given SenderProfile actually names
# need to be set; unset ones just make that specific provider unusable, not
# a startup failure. Every sender profile in this repo's own dev .env uses
# "mock" (zero cost, zero network, zero risk of a real send).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=
AWS_REGION=
SENDGRID_API_KEY=

# Webhook authentication (Sprint 6) -- see docs/SECURITY.md "Webhook
# authentication" and src/services/webhookSignature.ts. Each is independent;
# an unconfigured provider falls back to WEBHOOK_SHARED_SECRET, then to
# fully open (dev/test only) if that's unset too -- every request logs which
# tier actually authenticated it.
#
# Resend: Svix-format signing secret from the Resend webhook dashboard
# (starts with "whsec_").
RESEND_WEBHOOK_SECRET=
# SendGrid: base64 DER-encoded ECDSA public verification key from the Event
# Webhook settings page (Twilio SendGrid dashboard).
SENDGRID_WEBHOOK_PUBLIC_KEY=
# SES delivers via SNS -- signature verification fetches the signing cert
# from an AWS-owned *.amazonaws.com host only (SSRF-guarded). Set to
# "false" only to disable while debugging locally; never in production.
SES_SNS_VERIFY_SIGNATURE=true
# Fallback shared-secret token, checked via ?token= query param or
# X-Webhook-Token header when a provider's real signing key above isn't set.
WEBHOOK_SHARED_SECRET=

LOG_LEVEL=info
