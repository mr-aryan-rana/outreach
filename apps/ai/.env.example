# Same physical Postgres database as apps/backend, isolated in its own "ai"
# schema -- see docs/DATABASE.md "AI schema isolation". Same pgbouncer rule
# as apps/backend: AI_DATABASE_URL = pooled (port 6543), AI_DIRECT_URL =
# direct (port 5432, migrations only). Quote these values in your .env --
# the `&` between query params is otherwise interpreted as a shell
# background-job operator if this file is ever `source`d directly.
AI_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=ai"
AI_DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres?schema=ai"

# Same Upstash Redis instance as apps/backend (rate limiting only -- apps/ai
# has no duplicate-prevention/idempotency use for Redis).
REDIS_URL="rediss://default:<password>@<db-name>.upstash.io:6379"

PORT=8004

# Comma-separated, own key set (not shared with apps/backend's API_KEYS).
# Generate with e.g. `openssl rand -hex 32`.
AI_API_KEYS=

# apps/ai fetches creator content from apps/backend's own API rather than
# querying its tables directly -- needs a valid apps/backend API key.
BACKEND_URL="http://localhost:3000"
BACKEND_API_KEY=

# CORS: comma-separated allowed browser origins. Empty/unset = deny all
# cross-origin requests (default).
CORS_ALLOWED_ORIGINS=

# Provider credentials -- only the ones actually selected below need to be
# set; a provider requested without its key configured fails that specific
# call (triggering fallback), not service startup.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_MODEL=gemini-1.5-flash

# Never lock to one provider -- both configurable, fallback used on any
# primary failure (timeout, circuit open, missing key, API error).
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=anthropic

AI_REQUEST_TIMEOUT_MS=30000
AI_CIRCUIT_BREAKER_THRESHOLD=5

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
API_KEY_RATE_LIMIT_MAX=120

LOG_LEVEL=info
