# Postgres, via Supabase (owned by apps/backend)
# DATABASE_URL = pooled connection (pgbouncer, port 6543) -- used at runtime
# DIRECT_URL   = direct connection (port 5432) -- used only by `prisma migrate`
# Get both from Supabase dashboard -> Project Settings -> Database -> Connection string
#
# DO NOT swap these. Confirmed live during RC1/RC2 load testing: pointing
# DATABASE_URL at the port-5432 direct connection instead of the pooled one
# reproduces real `FATAL: max clients reached in session mode - max clients
# are limited to pool_size: 15` errors at only ~100 concurrent requests --
# and that connection ceiling is per-project, shared with every other app on
# the same Supabase project, not exclusive to this backend. See
# docs/DATABASE.md "Connection pooling" and DEPLOYMENT.md "RC2 benchmark".
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres

# Redis, via Upstash (duplicate-prevention cache, owned by apps/backend)
# Get from Upstash dashboard -> your database -> "Redis Connect" -> ioredis (rediss:// = TLS)
REDIS_URL=rediss://default:<password>@<db-name>.upstash.io:6379

# Backend HTTP server
PORT=4000

# Python microservice URLs (called by apps/backend/src/routes/ingest.ts)
SEARCH_SERVICE_URL=http://localhost:8001
EXTRACTOR_SERVICE_URL=http://localhost:8002
VALIDATOR_SERVICE_URL=http://localhost:8003

# Search/crawl behavior
SEARCH_CONCURRENCY=5
REQUEST_TIMEOUT=20

# Cache TTLs (seconds)
CACHE_TTL=3600
VALIDATION_TTL=86400
# Duplicate-prevention keys (creator:email:*/creator:website:*) -- separate
# from CACHE_TTL on purpose, see apps/backend/src/config/env.ts. Default 30 days.
DUPLICATE_TTL_SECONDS=2592000

LOG_LEVEL=info

# Rate limiting (fixed-window, backed by Redis so it's shared across instances)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
INGEST_RATE_LIMIT_MAX=10
# Per-API-key quota, on top of (not instead of) the per-IP RATE_LIMIT_MAX above
API_KEY_RATE_LIMIT_MAX=300

# Circuit breaker: consecutive failures before a downstream service call opens
CIRCUIT_BREAKER_THRESHOLD=5

# Idempotency: how long a stored /ingest/run result is replayed for a repeated
# Idempotency-Key header
IDEMPOTENCY_TTL_SECONDS=86400

# API keys, comma-separated -- every /api/v1/* request must send one via the
# X-API-Key header. Generate with e.g. `openssl rand -hex 32`. Rotation: add
# the new key alongside the old one, deploy, wait for callers to switch,
# remove the old key, deploy again -- both keys authenticate during the
# overlap window.
API_KEYS=

# CORS: comma-separated list of allowed browser origins, e.g.
# https://app.example.com,https://staging.example.com
# Empty/unset = deny all cross-origin browser requests (default). API key
# auth alone doesn't make arbitrary origins safe to allow -- a browser-based
# caller would still need to expose its key client-side. Set this once a
# real, trusted frontend origin exists.
CORS_ALLOWED_ORIGINS=

# NOTE: AI_API_KEY / SMTP_* / EMAIL_* vars from PROJECT.md are intentionally
# omitted here — the AI personalization and email-sending services are not
# built yet. Add them when those slices land.
